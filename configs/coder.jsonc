{
  "$schema": "https://opencode.ai/config.json",

  "enabled_providers": ["lmstudio"],
  "model": "lmstudio/qwen3.8-27b",
  "small_model": "lmstudio/qwen3.8-27b",
  "default_agent": "qwen-local",

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio Local",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "timeout": 1800000
      },
      "models": {
        "qwen3.8-27b": {
          "id": "qwen3.8-27b-gguf-q8-mtp",
          "name": "Qwen 3.8 27B GGUF Q8_0 + MTP",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 32000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": true,
              "preserve_thinking": true,
              "reasoning_effort": "medium"
            }
          },
          "variants": {
            "low": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "preserve_thinking": true,
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "preserve_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "xhigh": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "preserve_thinking": true,
                "reasoning_effort": "xhigh"
              }
            }
          }
        }
      }
    }
  },

  "agent": {
    "qwen-local": {
      "description": "Primary local coding agent tuned for Qwen 3.8 27B",
      "mode": "primary",
      "model": "lmstudio/qwen3.8-27b",
      "variant": "medium",
      "prompt": "{file:../prompts/qwen-local.txt}",
      "temperature": 1.0,
      "top_p": 0.95,
      "steps": 32,
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "task": "deny",
        "external_directory": "ask",
        "doom_loop": "ask",
        "context7_*": "allow",
        "gh_grep_*": "allow",
        "bash": {
          "*": "allow",
          "sudo *": "ask",
          "rm -rf *": "ask",
          "git commit*": "ask",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git clean*": "ask",
          "git checkout -- *": "ask",
          "git restore *": "ask",
          "gh pr create*": "ask",
          "npm publish*": "ask"
        }
      }
    }
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },

  "formatter": true,
  "lsp": true,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".venv/**",
      "vendor/**"
    ]
  }
}
