{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen3.8-27b",
  "default_agent": "qwen-local",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "codemode": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false,
        "codemode": false
      }
    }
  },
  "formatter": true,
  "lsp": true,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "buffer": 32000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".venv/**",
      "vendor/**"
    ]
  },
  "providers": {
    "lmstudio": {
      "name": "LM Studio Local",
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B GGUF Q8_0 + MTP",
          "limit": {
            "context": 131072,
            "output": 32000
          },
          "modelID": "qwen3.8-27b-gguf-q8-mtp",
          "compatibility": {
            "reasoningField": "reasoning_content",
            "maxTokensField": "max_tokens"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": true,
              "preserve_thinking": true,
              "reasoning_effort": "medium"
            },
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "preserve_thinking": true,
                  "reasoning_effort": "low"
                }
              }
            },
            {
              "id": "medium",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "preserve_thinking": true,
                  "reasoning_effort": "medium"
                }
              }
            },
            {
              "id": "xhigh",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "preserve_thinking": true,
                  "reasoning_effort": "xhigh"
                }
              }
            }
          ]
        }
      },
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "timeout": 1800000,
        "apiKey": ""
      }
    }
  },
  "agents": {
    "qwen-local": {
      "description": "Primary local coding agent tuned for Qwen 3.8 27B",
      "mode": "primary",
      "model": "lmstudio/qwen3.8-27b#medium",
      "steps": 32,
      "system": "{file:../prompts/qwen-local.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "lsp",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "todo",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "doom_loop",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "context7_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "gh_grep_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sudo *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "rm -rf *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git commit*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git reset --hard*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git clean*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git checkout -- *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git restore *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "gh pr create*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "npm publish*",
          "effect": "ask"
        }
      ]
    },
    "title": {
      "model": "lmstudio/qwen3.8-27b"
    },
    "compaction": {
      "model": "lmstudio/qwen3.8-27b"
    }
  },
  "plugins": [
    "../plugins/coder"
  ]
}
