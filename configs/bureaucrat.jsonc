{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen3.8-27b",
  "default_agent": "qwen-bureaucrat",
  "mcp": {
    "servers": {
      "gmail": {
        "type": "local",
        "command": [
          "node",
          "../scripts/mcp-gmail.mjs"
        ],
        "disabled": false,
        "codemode": false
      },
      "google_drive": {
        "type": "local",
        "command": [
          "node",
          "../scripts/mcp-google-drive.mjs"
        ],
        "environment": {
          "GOOGLE_DRIVE_MCP_SCOPES": "drive,documents,spreadsheets"
        },
        "disabled": false,
        "codemode": false
      },
      "chrome": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect",
          "--slim"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  },
  "formatter": false,
  "lsp": false,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "buffer": 32000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".venv/**",
      "vendor/**"
    ]
  },
  "providers": {
    "lmstudio": {
      "name": "LM Studio Local",
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B GGUF Q8_0 + MTP",
          "limit": {
            "context": 131072,
            "output": 32000
          },
          "modelID": "qwen3.8-27b-gguf-q8-mtp",
          "compatibility": {
            "reasoningField": "reasoning_content",
            "maxTokensField": "max_tokens"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": true,
              "preserve_thinking": true,
              "reasoning_effort": "low"
            },
            "temperature": 0.5,
            "top_p": 0.9,
            "top_k": 40
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "preserve_thinking": true,
                  "reasoning_effort": "low"
                }
              }
            }
          ]
        }
      },
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "timeout": 1800000,
        "apiKey": ""
      }
    }
  },
  "agents": {
    "qwen-bureaucrat": {
      "description": "Local executive assistant and records officer for Gmail, Google Drive, and Google Sheets",
      "mode": "primary",
      "model": "lmstudio/qwen3.8-27b#low",
      "steps": 24,
      "system": "{file:../prompts/qwen-bureaucrat.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "gmail_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "google_drive_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "gmail_reply_all",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "gmail_*filter*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "gmail_*phishing*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "gmail_download_attachment",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "gmail_send_*",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "gmail_delete_*",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "google_drive_delete_*",
          "resource": "*",
          "effect": "ask"
        }
      ]
    },
    "title": {
      "model": "lmstudio/qwen3.8-27b"
    },
    "compaction": {
      "model": "lmstudio/qwen3.8-27b"
    }
  },
  "plugins": [
    "../plugins/bureaucrat"
  ]
}
